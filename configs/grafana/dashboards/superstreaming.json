{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Origin",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "up{job=\"mediamtx-origin-0\"}", "legendFormat": "origin-0", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-red", "value": null },
              { "color": "dark-green", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 2,
      "title": "Read Replica",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "up{job=\"mediamtx-read\"}", "legendFormat": "read", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-red", "value": null },
              { "color": "dark-green", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "title": "Active Streams",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "count(paths{job=\"mediamtx-origin-0\", state=\"ready\"}) or vector(0)", "legendFormat": "streams", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-red", "value": null },
              { "color": "dark-yellow", "value": 1 },
              { "color": "dark-green", "value": 5 }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "title": "RTSP Publishers",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "count(rtsp_sessions{job=\"mediamtx-origin-0\", state=\"publish\"}) or vector(0)", "legendFormat": "publishers", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-red", "value": null },
              { "color": "dark-green", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 5,
      "title": "Origin→Read Pulls",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "count(rtsp_sessions{job=\"mediamtx-origin-0\", state=\"read\"}) or vector(0)", "legendFormat": "pulls", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-yellow", "value": null },
              { "color": "dark-green", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 6,
      "title": "WebRTC Viewers",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "count(webrtc_sessions{job=\"mediamtx-read\", state=\"read\"}) or vector(0)", "legendFormat": "viewers", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-blue", "value": null },
              { "color": "semi-dark-blue", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 10,
      "title": "Ingest & Throughput",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "panels": []
    },

    {
      "id": 11,
      "title": "Per-stream Ingest Bitrate",
      "description": "Inbound bits/s per stream at origin (rate over 1m window)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 14, "h": 8 },
      "targets": [
        {
          "expr": "rate(paths_inbound_bytes{job=\"mediamtx-origin-0\", state=\"ready\"}[1m]) * 8",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        }
      }
    },

    {
      "id": 12,
      "title": "Total Origin Ingest vs Viewer Outbound",
      "description": "Sum of all stream ingest (origin) vs total bits delivered to viewers (read replica)",
      "type": "timeseries",
      "gridPos": { "x": 14, "y": 5, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(paths_inbound_bytes{job=\"mediamtx-origin-0\"}[1m])) * 8",
          "legendFormat": "Origin Ingest",
          "refId": "A"
        },
        {
          "expr": "sum(rate(paths_outbound_bytes{job=\"mediamtx-read\"}[1m])) * 8",
          "legendFormat": "Viewer Outbound",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        }
      }
    },

    {
      "id": 20,
      "title": "RTSP Sessions",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "panels": []
    },

    {
      "id": 21,
      "title": "RTSP Sessions by State",
      "description": "publish = ffmpeg ingest; read = internal pull by read replica",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum by (state)(rtsp_sessions{job=\"mediamtx-origin-0\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        }
      }
    },

    {
      "id": 22,
      "title": "RTSP Publish Bitrate per Stream",
      "description": "Inbound bytes/s per publisher session, aggregated by path",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 14, "w": 16, "h": 7 },
      "targets": [
        {
          "expr": "sum by (path)(rate(rtsp_sessions_inbound_bytes{job=\"mediamtx-origin-0\", state=\"publish\"}[1m])) * 8",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" }
        }
      }
    },

    {
      "id": 30,
      "title": "WebRTC Viewers",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "panels": []
    },

    {
      "id": 31,
      "title": "WebRTC Viewer Sessions",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 22, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(webrtc_sessions{job=\"mediamtx-read\", state=\"read\"}) or vector(0)",
          "legendFormat": "Viewers",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": { "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" }
        }
      }
    },

    {
      "id": 32,
      "title": "WebRTC Outbound Bitrate per Viewer",
      "description": "Bits/s delivered to each WebRTC viewer, keyed by stream path",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 22, "w": 16, "h": 7 },
      "targets": [
        {
          "expr": "sum by (path)(rate(webrtc_sessions_outbound_bytes{job=\"mediamtx-read\"}[1m])) * 8",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        }
      }
    },

    {
      "id": 40,
      "title": "Stream Quality",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 },
      "panels": []
    },

    {
      "id": 41,
      "title": "RTSP Inbound RTP Errors (rate/s)",
      "description": "Malformed or undecodable RTP packets arriving from publishers. Sustained >0 = encoder/network issue.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 30, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum by (path)(rate(rtsp_sessions_inbound_rtp_packets_in_error{job=\"mediamtx-origin-0\"}[1m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },

    {
      "id": 42,
      "title": "RTSP Inbound RTP Jitter",
      "description": "Inter-arrival jitter on inbound RTSP streams (publisher network stability). Higher = worse.",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 30, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "avg by (path)(rtsp_sessions_inbound_rtp_packets_jitter{job=\"mediamtx-origin-0\", state=\"publish\"})",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        }
      }
    },

    {
      "id": 43,
      "title": "WebRTC RTP Packet Loss (rate/s)",
      "description": "RTCP-reported packet loss on WebRTC viewer sessions. Sustained >0 = viewer network issue.",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 30, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum by (path)(rate(webrtc_sessions_rtp_packets_lost{job=\"mediamtx-read\"}[1m]))",
          "legendFormat": "{{path}} lost",
          "refId": "A"
        },
        {
          "expr": "avg by (path)(webrtc_sessions_rtp_packets_jitter{job=\"mediamtx-read\"})",
          "legendFormat": "{{path}} jitter",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        }
      }
    },

    {
      "id": 50,
      "title": "RTP Packet Counts",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 37, "w": 24, "h": 1 },
      "panels": []
    },

    {
      "id": 51,
      "title": "RTSP Inbound RTP Packets/s (per stream)",
      "description": "Total inbound RTP packets/s per publisher — proxy for encoder health",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (path)(rate(rtsp_sessions_inbound_rtp_packets{job=\"mediamtx-origin-0\", state=\"publish\"}[1m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" }
        }
      }
    },

    {
      "id": 52,
      "title": "WebRTC Outbound RTP Packets/s (per viewer)",
      "description": "Total outbound RTP packets/s per WebRTC viewer session",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (path)(rate(webrtc_sessions_outbound_rtp_packets{job=\"mediamtx-read\"}[1m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" }
        }
      }
    }

  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["superstreaming", "mediamtx"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SuperStreaming",
  "uid": "superstreaming-main",
  "version": 1
}
